-- Arrastar (mouse e toque)
local function makeDraggable(handle, target)
	local dragging = false
	local dragStart, startPos

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = target.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
end

makeDraggable(topBar, window)

-- Giro da free cam (botão direito no PC / arrastar no celular)
UserInputService.InputChanged:Connect(function(input, gameProcessed)
	if not fcEnabled then return end

	if input.UserInputType == Enum.UserInputType.MouseMovement then
		if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			fcYaw = fcYaw - input.Delta.X * 0.003
			fcPitch = math.clamp(fcPitch - input.Delta.Y * 0.003, -1.5, 1.5)
		end
	elseif input.UserInputType == Enum.UserInputType.Touch and not gameProcessed then
		fcYaw = fcYaw - input.Delta.X * 0.004
		fcPitch = math.clamp(fcPitch - input.Delta.Y * 0.004, -1.5, 1.5)
	end
end)

-- Atualização ao vivo
RunService.RenderStepped:Connect(function(dt)
	local locked = currentTarget ~= nil

	dot.BackgroundColor3 = lockEnabled and Color3.fromRGB(70, 200, 100) or Color3.fromRGB(200, 60, 60)
	if locked then
		statusLabel.Text = "Lock: TRAVADO"
	elseif lockEnabled then
		statusLabel.Text = "Lock: PROCURANDO"
	else
		statusLabel.Text = "Lock: DESATIVADO"
	end

	circleStroke.Color = locked and Color3.fromRGB(70, 200, 100) or C.accent

	local tracerShown = false
	if locked then
		targetLabel.Text = "Alvo: " .. currentTarget.DisplayName
		local part = getAimPart(currentTarget)
		if part then
			distLabel.Text = string.format("Distância: %d studs", math.floor((part.Position - camera.CFrame.Position).Magnitude))

			if showTracer then
				local sp, onScreen = camera:WorldToViewportPoint(part.Position)
				if onScreen and sp.Z > 0 then
					local c = camera.ViewportSize / 2
					local p = Vector2.new(sp.X, sp.Y)
					local d = p - c
					tracer.Size = UDim2.fromOffset(d.Magnitude, 1.5)
					tracer.Position = UDim2.fromOffset((c.X + p.X) / 2, (c.Y + p.Y) / 2)
					tracer.Rotation = math.deg(math.atan2(d.Y, d.X))
					tracerShown = true
				end
			end
		end
	else
		targetLabel.Text = "Alvo: —"
		distLabel.Text = "Distância: —"
	end
	tracer.Visible = tracerShown

	updateFreeCam(dt)
	updateEsp()
end)

