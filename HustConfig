local function getOwnHumanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function getControls()
	local ok, controls = pcall(function()
		local scripts = player:FindFirstChild("PlayerScripts")
		local module = scripts and scripts:FindFirstChild("PlayerModule")
		return module and require(module):GetControls()
	end)
	return ok and controls or nil
end

local function startFreeCam()
	if fcEnabled then return end
	fcEnabled = true

	local cf = camera.CFrame
	fcPos = cf.Position
	fcVel = Vector3.zero
	fcPitch, fcYaw = cf:ToOrientation()
	fcCurPitch, fcCurYaw = fcPitch, fcYaw
	camera.CameraType = Enum.CameraType.Scriptable

	if UserInputService.KeyboardEnabled then
		fcControls = getControls()
		if fcControls then fcControls:Disable() end
	else
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root and not root.Anchored then
			root.Anchored = true
			fcAnchoredRoot = root
		end
		if fcButtons then fcButtons.Visible = true end
	end
end

local function stopFreeCam()
	if not fcEnabled then return end
	fcEnabled = false
	fcUp, fcDown = false, false
	if fcButtons then fcButtons.Visible = false end

	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	if fcControls then
		fcControls:Enable()
		fcControls = nil
	end
	if fcAnchoredRoot then
		fcAnchoredRoot.Anchored = false
		fcAnchoredRoot = nil
	end

	camera.CameraType = Enum.CameraType.Custom
	local hum = getOwnHumanoid()
	if hum then camera.CameraSubject = hum end
end

local function updateFreeCam(dt)
	if not fcEnabled then return end

	if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
	elseif UserInputService.MouseBehavior == Enum.MouseBehavior.LockCurrentPosition then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end

	local rot = CFrame.fromOrientation(fcPitch, fcYaw, 0)
	local move = Vector3.zero

	if UserInputService.KeyboardEnabled then
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += rot.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= rot.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += rot.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= rot.RightVector end
	else
		local hum = getOwnHumanoid()
		if hum and hum.MoveDirection.Magnitude > 0 then
			move += hum.MoveDirection
		end
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.E) then move += Vector3.yAxis end
	if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move -= Vector3.yAxis end

	if move.Magnitude > 0 then
		local speed = fcSpeed
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
			speed = speed * 3
		end
		fcPos += move.Unit * speed * dt
	end

	camera.CFrame = CFrame.new(fcPos) * rot
end

local function teleportForward()
	local char = player.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return end

	local offset = root.CFrame.LookVector * TELEPORT_DISTANCE
	local seat = hum.SeatPart

	if seat then
		-- sentado: leva o seat e tudo que está preso a ele (veículo, personagem, etc.)
		for _, part in ipairs(seat:GetConnectedParts(true)) do
			part.CFrame = part.CFrame + offset
		end
	else
		char:PivotTo(char:GetPivot() + offset)
	end
end

