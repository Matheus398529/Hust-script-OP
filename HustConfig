local function removeEsp(plr)
	local obj = espObjects[plr]
	if obj then
		obj.gui:Destroy()
		if obj.outline then
			obj.outline:Destroy()
		end
		espObjects[plr] = nil
	end
end

local function clearEsp()
	for plr in pairs(espObjects) do
		removeEsp(plr)
	end
end

