workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	camera = workspace.CurrentCamera
end)

local TOGGLE_KEY = Enum.KeyCode.Q   -- liga/desliga o aimbot
local ESP_KEY = Enum.KeyCode.E      -- liga/desliga o ESP
local HIDE_KEY = Enum.KeyCode.H     -- esconde/mostra a interface
local maxDistance = 2000            -- alcance do aimbot (studs)
local espDistance = 2000            -- alcance do ESP (studs)
local fovRadius = 150               -- raio da bola em pixels
local BIND_NAME = "CameraLockHead"

local lockEnabled = false
local currentTarget = nil
local espEnabled = false
local espObjects = {}

-- Amigos que o aimbot ignora (nome de usuário, não DisplayName)
local IGNORE_LIST = {
	["rip_vamp29"] = true,
	["hula2175217576"] = true,
	["nicolasmarciano3"] = true,
}

local function isIgnored(plr)
	return IGNORE_LIST[plr.Name:lower()] == true
end

----------------------------------------------------------------
-- CAMERA LOCK
----------------------------------------------------------------
local function getHead(plr)
	local char = plr.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local head = char:FindFirstChild("Head")
	if hum and head and hum.Health > 0 then
		return head
	end
	return nil
end

local function getAimPart(plr)
	local char = plr.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil end
	return char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("HumanoidRootPart")
end

-- Procura o player mais perto do centro da tela, dentro da bola
local function findBestTarget()
	local best, bestDist = nil, math.huge
	local camPos = camera.CFrame.Position
	local center = camera.ViewportSize / 2

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and not isIgnored(plr) then
			local part = getAimPart(plr)
			if part then
				local worldDist = (part.Position - camPos).Magnitude
				if worldDist <= maxDistance and worldDist > 0 then
					local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
					if onScreen and screenPos.Z > 0 then
						local fromCenter = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
						if fromCenter <= fovRadius and fromCenter < bestDist then
							bestDist = fromCenter
							best = plr
						end
					end
				end
			end
		end
	end

	return best
end

local function toggle()
	lockEnabled = not lockEnabled
	if not lockEnabled then
		currentTarget = nil
	end
end

RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function()
	if not lockEnabled then return end

	-- mantém o alvo até ele chegar a 0 de HP (ou sair do alcance / do jogo)
	if currentTarget then
		local part = getAimPart(currentTarget)
		if not part or (part.Position - camera.CFrame.Position).Magnitude > maxDistance then
			currentTarget = nil
		end
	end

	-- sem alvo: pega o próximo player que estiver dentro da bola
	if not currentTarget then
		currentTarget = findBestTarget()
	end

	if currentTarget then
		local part = getAimPart(currentTarget)
		if part then
			local camPos = camera.CFrame.Position
			camera.CFrame = CFrame.new(camPos, part.Position)
		end
	end
end)

----------------------------------------------------------------
-- ESP
----------------------------------------------------------------
local function removeEsp(plr)
	local obj = espObjects[plr]
	if obj then
		obj.gui:Destroy()
		if obj.outline then
			obj.outline:Destroy()
		end
		espObjects[plr] = nil
	end
end

local function clearEsp()
	for plr in pairs(espObjects) do
		removeEsp(plr)
	end
end

local function createEsp(plr, head)
	local bb = Instance.new("BillboardGui")
	bb.Name = "ESP_" .. plr.Name
	bb.Adornee = head
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(140, 56)
	bb.StudsOffset = Vector3.new(0, 2.8, 0)
	bb.ResetOnSpawn = false
	bb.Parent = player:WaitForChild("PlayerGui")

	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.new(1, 0, 0, 15)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 13
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.TextStrokeTransparency = 0.3
	nameLabel.Text = plr.DisplayName
	nameLabel.Parent = bb

	local barBg = Instance.new("Frame")
	barBg.Position = UDim2.fromOffset(15, 19)
	barBg.Size = UDim2.new(1, -30, 0, 8)
	barBg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	barBg.BorderSizePixel = 0
	barBg.Parent = bb
	Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(1, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(60, 220, 90)
	fill.BorderSizePixel = 0
	fill.Parent = barBg
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local info = Instance.new("TextLabel")
	info.BackgroundTransparency = 1
	info.Position = UDim2.fromOffset(0, 30)
	info.Size = UDim2.new(1, 0, 0, 14)
	info.Font = Enum.Font.GothamMedium
	info.TextSize = 11
	info.TextColor3 = Color3.fromRGB(230, 230, 240)
	info.TextStrokeTransparency = 0.4
	info.Text = ""
	info.Parent = bb

	-- contorno azul no corpo todo
	local outline = Instance.new("Highlight")
	outline.Name = "ESP_Outline_" .. plr.Name
	outline.Adornee = plr.Character
	outline.FillTransparency = 1
	outline.OutlineTransparency = 0
	outline.OutlineColor = Color3.fromRGB(0, 140, 255)
	outline.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	outline.Parent = camera

	espObjects[plr] = {gui = bb, fill = fill, info = info, outline = outline}
	return espObjects[plr]
end

local function updateEsp()
	if not espEnabled then
		if next(espObjects) then
			clearEsp()
		end
		return
	end

	local camPos = camera.CFrame.Position

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local head = getHead(plr)
			local show = false
			local dist = 0

			if head then
				dist = (head.Position - camPos).Magnitude
				if dist <= espDistance then
					local _, onScreen = camera:WorldToViewportPoint(head.Position)
					show = onScreen
				end
			end

			if show then
				local obj = espObjects[plr]
				if obj and (not obj.outline.Parent or not obj.gui.Parent) then
					removeEsp(plr)
					obj = nil
				end
				obj = obj or createEsp(plr, head)

				if obj.gui.Adornee ~= head then
					obj.gui.Adornee = head
				end
				if obj.outline.Adornee ~= plr.Character then
					obj.outline.Adornee = plr.Character
				end

				local hum = plr.Character:FindFirstChildOfClass("Humanoid")
				local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
				obj.fill.Size = UDim2.new(ratio, 0, 1, 0)
				obj.fill.BackgroundColor3 = Color3.fromRGB(220, 60, 60):Lerp(Color3.fromRGB(60, 220, 90), ratio)
				obj.info.Text = string.format("HP %d/%d  |  %d studs", math.floor(hum.Health), math.floor(hum.MaxHealth), math.floor(dist))
				obj.gui.Enabled = true
			else
				removeEsp(plr)
			end
		end
	end
end

