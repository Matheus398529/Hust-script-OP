-- CAMERA LOCK
----------------------------------------------------------------
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getHead(plr)
	local char = plr.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local head = char:FindFirstChild("Head")
	if hum and head and hum.Health > 0 then
		return head
	end
	return nil
end

local function getAimPart(plr)
	local char = plr.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil end
	if aimPartMode == "Cabeça" then
		local head = char:FindFirstChild("Head")
		if head then return head end
	end
	return char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("HumanoidRootPart")
end

local function getAimPos(part)
	if predictionEnabled then
		return part.Position + part.AssemblyLinearVelocity * (predictionMs / 1000)
	end
	return part.Position
end

local function isVisible(part, plr)
	local ignore = {camera}
	if player.Character then
		table.insert(ignore, player.Character)
	end
	rayParams.FilterDescendantsInstances = ignore
	local origin = camera.CFrame.Position
	local res = workspace:Raycast(origin, part.Position - origin, rayParams)
	return res == nil or res.Instance:IsDescendantOf(plr.Character)
end

local function isTeammate(plr)
	return teamCheck and plr.Team ~= nil and plr.Team == player.Team
end

-- Procura o melhor player dentro da bola
local function findBestTarget()
	local best, bestScore = nil, math.huge
	local camPos = camera.CFrame.Position
	local center = camera.ViewportSize / 2

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and not isIgnored(plr) and not isTeammate(plr) then
			local part = getAimPart(plr)
			if part then
				local worldDist = (part.Position - camPos).Magnitude
				if worldDist <= maxDistance and worldDist > 0 then
					local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
					if onScreen and screenPos.Z > 0 then
						local fromCenter = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
						if fromCenter <= fovRadius and (not wallCheck or isVisible(part, plr)) then
							local score
							if priorityMode == "Mais perto" then
								score = worldDist
							elseif priorityMode == "Menor vida" then
								local hum = plr.Character:FindFirstChildOfClass("Humanoid")
								score = hum and hum.Health or math.huge
							else
								score = fromCenter
							end
							if score < bestScore then
								bestScore = score
								best = plr
							end
						end
					end
				end
			end
		end
	end

	return best
end

local function toggle()
	lockEnabled = not lockEnabled
	if not lockEnabled then
		currentTarget = nil
	end
	syncAim(lockEnabled)
end

RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function()
	if fcEnabled then return end
	if not lockEnabled then return end

	if holdMode and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		currentTarget = nil
		return
	end

	-- mantém o alvo até ele chegar a 0 de HP (ou sair do alcance / do jogo)
	if currentTarget then
		local part = getAimPart(currentTarget)
		if not part
			or (part.Position - camera.CFrame.Position).Magnitude > maxDistance
			or isTeammate(currentTarget)
			or (wallCheck and not isVisible(part, currentTarget)) then
			currentTarget = nil
		end
	end

	-- sem alvo: pega o próximo player que estiver dentro da bola
	if not currentTarget then
		currentTarget = findBestTarget()
	end

	if currentTarget then
		local part = getAimPart(currentTarget)
		if part then
			local camPos = camera.CFrame.Position
			local goal = CFrame.new(camPos, getAimPos(part))
			if smoothness > 0 then
				local alpha = math.clamp(1 - smoothness / 100, 0.03, 1)
				camera.CFrame = camera.CFrame:Lerp(goal, alpha)
			else
				camera.CFrame = goal
			end
		end
	end
end)

