	local function set(v, silent)
		state = v
		local info = TweenInfo.new(0.15, Enum.EasingStyle.Quad)
		TweenService:Create(sw, info, {BackgroundColor3 = v and C.accent or C.off}):Play()
		TweenService:Create(knob, info, {Position = v and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)}):Play()
		if not silent then
			callback(v)
		end
	end

	local btn = new("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
	}, row)
	btn.Activated:Connect(function()
		set(not state)
	end)

	set(default, true)
	return set
end

local function addInput(page, text, default, minV, maxV, callback)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = C.row,
		BorderSizePixel = 0,
	}, page)
	corner(row, 8)

	new("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -110, 1, 0),
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.text,
		Text = text,
	}, row)

	local box = new("TextBox", {
		Position = UDim2.new(1, -92, 0.5, -12),
		Size = UDim2.fromOffset(80, 24),
		BackgroundColor3 = Color3.fromRGB(40, 40, 58),
		BorderSizePixel = 0,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextColor3 = Color3.fromRGB(240, 240, 250),
		ClearTextOnFocus = false,
		Text = tostring(default),
	}, row)
	corner(box, 6)

	local value = default
	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then
			value = math.clamp(math.floor(n), minV, maxV)
			callback(value)
		end
		box.Text = tostring(value)
	end)
end

