-- Minimizar
local minimized = false
minBtn.Activated:Connect(function()
	minimized = not minimized
	minBtn.Text = minimized and "+" or "–"
	if minimized then
		content.Visible = false
		TweenService:Create(panel, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Size = MINI_SIZE}):Play()
	else
		TweenService:Create(panel, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Size = FULL_SIZE}):Play()
		task.delay(0.1, function()
			if not minimized then
				content.Visible = true
			end
		end)
	end
end)

-- Arrastar (mouse e toque)
local dragging = false
local dragStart, startPos

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = panel.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - dragStart
		panel.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)

-- Atualização ao vivo
RunService.RenderStepped:Connect(function()
	local locked = currentTarget ~= nil

	dot.BackgroundColor3 = lockEnabled and Color3.fromRGB(70, 200, 100) or Color3.fromRGB(200, 60, 60)
	if locked then
		statusLabel.Text = "Lock: TRAVADO"
	elseif lockEnabled then
		statusLabel.Text = "Lock: PROCURANDO"
	else
		statusLabel.Text = "Lock: DESATIVADO"
	end
	toggleBtn.Text = lockEnabled and "DESATIVAR LOCK  [Q]" or "ATIVAR LOCK  [Q]"
	toggleBtn.BackgroundColor3 = lockEnabled and Color3.fromRGB(190, 70, 70) or Color3.fromRGB(60, 150, 90)

	espBtn.Text = espEnabled and "DESATIVAR ESP  [E]" or "ATIVAR ESP  [E]"
	espBtn.BackgroundColor3 = espEnabled and Color3.fromRGB(190, 70, 70) or Color3.fromRGB(70, 110, 190)

	circleStroke.Color = locked and Color3.fromRGB(70, 200, 100) or Color3.fromRGB(0, 140, 255)

	if locked then
		targetLabel.Text = "Alvo: " .. currentTarget.DisplayName
		local part = getAimPart(currentTarget)
		if part then
			distLabel.Text = string.format("Distância: %d studs", math.floor((part.Position - camera.CFrame.Position).Magnitude))
		end
	else
		targetLabel.Text = "Alvo: —"
		distLabel.Text = "Distância: —"
	end

	updateEsp()
end)

