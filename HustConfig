local function removeEsp(plr)
	local obj = espObjects[plr]
	if obj then
		obj.gui:Destroy()
		if obj.outline then
			obj.outline:Destroy()
		end
		espObjects[plr] = nil
	end
end

local function clearEsp()
	for plr in pairs(espObjects) do
		removeEsp(plr)
	end
end

local function createEsp(plr, head)
	local bb = Instance.new("BillboardGui")
	bb.Name = "ESP_" .. plr.Name
	bb.Adornee = head
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(140, 56)
	bb.StudsOffset = Vector3.new(0, 2.8, 0)
	bb.ResetOnSpawn = false
	bb.Parent = player:WaitForChild("PlayerGui")

	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.new(1, 0, 0, 15)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 13
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.TextStrokeTransparency = 0.3
	nameLabel.Text = plr.DisplayName
	nameLabel.Parent = bb

	local barBg = Instance.new("Frame")
	barBg.Position = UDim2.fromOffset(15, 19)
	barBg.Size = UDim2.new(1, -30, 0, 8)
	barBg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	barBg.BorderSizePixel = 0
	barBg.Parent = bb
	Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(1, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(60, 220, 90)
	fill.BorderSizePixel = 0
	fill.Parent = barBg
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local info = Instance.new("TextLabel")
	info.BackgroundTransparency = 1
	info.Position = UDim2.fromOffset(0, 30)
	info.Size = UDim2.new(1, 0, 0, 14)
	info.Font = Enum.Font.GothamMedium
	info.TextSize = 11
	info.TextColor3 = Color3.fromRGB(230, 230, 240)
	info.TextStrokeTransparency = 0.4
	info.Text = ""
	info.Parent = bb

	-- contorno azul no corpo todo
	local outline = Instance.new("Highlight")
	outline.Name = "ESP_Outline_" .. plr.Name
	outline.Adornee = plr.Character
	outline.FillTransparency = 1
	outline.OutlineTransparency = 0
	outline.OutlineColor = Color3.fromRGB(0, 140, 255)
	outline.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	outline.Parent = camera

	espObjects[plr] = {gui = bb, fill = fill, info = info, outline = outline}
	return espObjects[plr]
end

local function updateEsp()
	if not espEnabled then
		if next(espObjects) then
			clearEsp()
		end
		return
	end

	local camPos = camera.CFrame.Position

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local head = getHead(plr)
			local show = false
			local dist = 0

			if head then
				dist = (head.Position - camPos).Magnitude
				if dist <= espDistance then
					local _, onScreen = camera:WorldToViewportPoint(head.Position)
					show = onScreen
				end
			end

			if show then
				local obj = espObjects[plr]
				if obj and (not obj.outline.Parent or not obj.gui.Parent) then
					removeEsp(plr)
					obj = nil
				end
				obj = obj or createEsp(plr, head)

				if obj.gui.Adornee ~= head then
					obj.gui.Adornee = head
				end
				if obj.outline.Adornee ~= plr.Character then
					obj.outline.Adornee = plr.Character
				end

				local hum = plr.Character:FindFirstChildOfClass("Humanoid")
				local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
				obj.fill.Size = UDim2.new(ratio, 0, 1, 0)
				obj.fill.BackgroundColor3 = Color3.fromRGB(220, 60, 60):Lerp(Color3.fromRGB(60, 220, 90), ratio)
				obj.info.Text = string.format("HP %d/%d  |  %d studs", math.floor(hum.Health), math.floor(hum.MaxHealth), math.floor(dist))
				obj.gui.Enabled = true
			else
				removeEsp(plr)
			end
		end
	end
end

local function toggleEsp()
	espEnabled = not espEnabled
	if not espEnabled then
		clearEsp()
	end
	syncEsp(espEnabled)
end

